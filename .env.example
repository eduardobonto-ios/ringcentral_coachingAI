# Supabase project settings — Project Settings -> API in the Supabase dashboard.
# Safe to expose to the browser (protected by Row Level Security, see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the API is hosted. Leave blank for local dev (Vite proxies /api to :8787).
# In production the API runs on its own always-on host, because the nightly RingCentral sync
# takes 30-45 minutes and cannot run on serverless. Example: https://coaching-api.up.railway.app
VITE_API_BASE_URL=
