PORT=8787

# Transactional email (Resend) — used for coaching emails and weekly manager reports
RESEND_API_KEY=
EMAIL_FROM="Coaching Bot <onboarding@resend.dev>"

# Set this to let the server analyze new calls automatically (POST /api/upload).
# Without it, uploads are transcribed and stored but left in "needs-analysis" status.
ANTHROPIC_API_KEY=

# Where weekly manager reports get sent (used later by weeklyReport.ts)
MANAGER_EMAIL=

# Transcription via OpenAI's Whisper API (cloud) — no local model/build needed.
OPENAI_API_KEY=

# Supabase project settings — Project Settings -> API in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security: never expose it to the frontend,
# never commit it, never paste it into chat/logs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the short-lived tokens on /audio URLs (see audioToken.ts). Falls back to
# SUPABASE_SERVICE_ROLE_KEY if unset — set this separately in production.
AUDIO_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# RingCentral — automatic call-recording ingestion (server/src/ringcentralSync.ts)
#
# Create the app at developers.ringcentral.com by SIGNING IN with Valveman's existing
# RingEX credentials. Do NOT use the "Try free" developer-sandbox signup: it is
# geo-restricted (blocked in PH) and a sandbox contains no real agent calls anyway.
# Production API access is included with RingEX at no extra cost.
#
# App type: REST API app, "JWT auth flow". Permissions: Read Call Log, Read Call Recording,
# Read Accounts (the last one is what maps an extension to an agent's email).
#
# RINGCENTRAL_JWT is a long-lived credential that can read every recorded customer call.
# Treat it exactly like SUPABASE_SERVICE_ROLE_KEY: never commit it, never expose it to the
# frontend, never paste it into chat or logs.
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=

# Production. Only change this if you deliberately bought a sandbox:
# https://platform.devtest.ringcentral.com
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com

# Outbound coaching email. OFF unless set to exactly "true".
# Agents read their coaching by signing into the app, so mail is a convenience — and the
# RingCentral call log includes people who are not coached agents. Turn this on only once the
# recipient list is settled; sent mail cannot be recalled.
COACHING_EMAILS_ENABLED=false
